<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="30dp" android:background="#F5F7FA">
    <EditText android:id="@+id/et_user" android:layout_width="match_parent" android:layout_height="50dp" android:hint="账号"/>
    <EditText android:id="@+id/et_pass" android:layout_width="match_parent" android:layout_height="50dp" android:hint="密码" android:inputType="textPassword" android:layout_marginTop="10dp"/>
    <Button android:id="@+id/btn_login" android:layout_width="match_parent" android:layout_height="55dp" android:text="登录" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginTop="20dp"/>
    <TextView android:id="@+id/tv_register" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="注册账号" android:layout_marginTop="15dp"/>
    <TextView android:id="@+id/tv_reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="找回密码" android:layout_marginTop="10dp"/>
</LinearLayout>