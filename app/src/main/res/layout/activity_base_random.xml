<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="25dp" android:background="#F5F7FA">
    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_result" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="等待随机" android:textSize="20sp" android:layout_marginTop="20dp"/>
    <Button android:id="@+id/btn_random" android:layout_width="200dp" android:layout_height="55dp" android:text="随机生成" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginTop="15dp"/>
    <EditText android:id="@+id/et_input" android:layout_width="match_parent" android:layout_height="50dp" android:hint="输入自定义内容" android:gravity="center" android:layout_marginTop="15dp"/>
    <Button android:id="@+id/btn_add" android:layout_width="180dp" android:layout_height="50dp" android:text="添加到池" android:background="@drawable/btn_warn" android:textColor="#fff" android:layout_marginTop="10dp"/>
    <ListView android:id="@+id/lv_list" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="15dp"/>
    <Button android:id="@+id/btn_back" android:layout_width="180dp" android:layout_height="50dp" android:text="返回" android:background="@drawable/btn_grey" android:textColor="#fff" android:layout_marginTop="10dp"/>
</LinearLayout>