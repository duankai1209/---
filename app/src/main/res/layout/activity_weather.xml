<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="30dp" android:background="#F5F7FA">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="天气查询" android:textSize="26sp" android:textStyle="bold"/>
    <EditText android:id="@+id/et_city" android:layout_width="200dp" android:layout_height="50dp" android:hint="输入城市拼音" android:gravity="center" android:layout_marginTop="20dp"/>
    <TextView android:id="@+id/tv_weather" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="加载中..." android:textSize="18sp" android:layout_marginTop="20dp"/>
    <Button android:id="@+id/btn_refresh" android:layout_width="220dp" android:layout_height="55dp" android:text="查询" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginTop="15dp"/>
    <Button android:id="@+id/btn_to_cloth" android:layout_width="220dp" android:layout_height="55dp" android:text="穿搭建议" android:background="@drawable/btn_warn" android:textColor="#fff" android:layout_marginTop="10dp"/>
    <Button android:id="@+id/btn_back" android:layout_width="220dp" android:layout_height="55dp" android:text="返回" android:background="@drawable/btn_grey" android:textColor="#fff" android:layout_marginTop="10dp"/>
</LinearLayout>