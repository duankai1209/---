<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="生活小助手——选择困难器"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_random_eat"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="美食选择"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_random_date"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="约会活动"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_random_clothes"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="穿搭推荐"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_weather"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="天气查询"
                android:textColor="#fff"
                android:background="@drawable/btn_warn"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_drink"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="饮品随机"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_sport"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="运动挑选"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_scenic"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="景点游玩"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_lottery"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="抽签占卜"
                android:textColor="#fff"
                android:background="@drawable/btn_warn"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_schedule"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="作息规划"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_motto"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="名言抽取"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:spacing="12dp">

            <Button
                android:id="@+id/btn_gift"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="礼物推荐"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>

            <Button
                android:id="@+id/btn_study"
                android:layout_width="160dp"
                android:layout_height="58dp"
                android:text="学习计划"
                android:textColor="#fff"
                android:background="@drawable/btn_primary"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_setting"
            android:layout_width="245dp"
            android:layout_height="58dp"
            android:text="自定义壁纸"
            android:textColor="#fff"
            android:background="@drawable/btn_grey"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>