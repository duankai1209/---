<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生活小助手——选择困难器" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>
        <Button android:id="@+id/btn_random_eat" android:layout_width="match_parent" android:layout_height="58dp" android:text="美食随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_random_date" android:layout_width="match_parent" android:layout_height="58dp" android:text="约会随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_drink" android:layout_width="match_parent" android:layout_height="58dp" android:text="饮品随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_sport" android:layout_width="match_parent" android:layout_height="58dp" android:text="运动随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_scenic" android:layout_width="match_parent" android:layout_height="58dp" android:text="景点随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_lottery" android:layout_width="match_parent" android:layout_height="58dp" android:text="抽签运势" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_motto" android:layout_width="match_parent" android:layout_height="58dp" android:text="名言随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_gift" android:layout_width="match_parent" android:layout_height="58dp" android:text="礼物随机" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_tool" android:layout_width="match_parent" android:layout_height="58dp" android:text="随机数/字母" android:background="@drawable/btn_primary" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_random_clothes" android:layout_width="match_parent" android:layout_height="58dp" android:text="穿搭推荐" android:background="@drawable/btn_warn" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_weather" android:layout_width="match_parent" android:layout_height="58dp" android:text="天气查询" android:background="@drawable/btn_warn" android:textColor="#fff" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_setting" android:layout_width="match_parent" android:layout_height="58dp" android:text="壁纸设置" android:background="@drawable/btn_grey" android:textColor="#fff"/>
    </LinearLayout>
</ScrollView>